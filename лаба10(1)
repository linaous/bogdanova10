def remove_duplicates_stable(lst,key = None):
    result = []
    seen = set()
    for item in lst:
        check_value = key(item) if key else item
        if check_value not in seen:
            seen.add(check_value)
            result.append(item)
    return result
#проверки
print(remove_duplicates_stable([1,2,1,3,2]))
print(remove_duplicates_stable(["a","A","b"],key=str.lower))
print(remove_duplicates_stable([]))

orig = [1,2,1]
res = remove_duplicates_stable(orig)
print(res)
print(orig) #исходный не меняется
